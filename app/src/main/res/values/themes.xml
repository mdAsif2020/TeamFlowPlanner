<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.TeamFlowPlanner" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/neon_blue</item>
        <item name="colorOnPrimary">@color/text_high_vibe</item>
        <item name="colorPrimaryContainer">@color/space_glass</item>
        <item name="colorSecondary">@color/neon_purple</item>
        <item name="colorSecondaryContainer">@color/space_glass</item>

        <item name="android:statusBarColor">@color/space_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/space_bg</item>

        <item name="colorSurface">@color/space_card</item>
        <item name="colorOnSurface">@color/text_high_vibe</item>
        <item name="colorOutline">@color/space_stroke</item>

        <!-- Menu Styling -->
        <item name="actionOverflowButtonStyle">@style/Widget.App.ActionButton.Overflow</item>
        <item name="actionBarPopupTheme">@style/ThemeOverlay.App.PopupMenu</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.App.LargeComponent</item>
    </style>

    <style name="Theme.TeamFlowPlanner" parent="Base.Theme.TeamFlowPlanner" />

    <!-- Style for the Overflow (three dots) button -->
    <style name="Widget.App.ActionButton.Overflow" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="android:tint">@color/neon_blue</item>
    </style>

    <style name="ThemeOverlay.App.PopupMenu" parent="ThemeOverlay.Material3.Dark">
        <item name="colorSurface">@color/space_glass</item>
        <item name="colorOnSurface">@color/text_high_vibe</item>
        <item name="android:textColorPrimary">@color/text_high_vibe</item>
        <item name="android:textColorSecondary">@color/text_mid_vibe</item>
        <item name="listDividerAlertDialog">@null</item>
    </style>

    <style name="ShapeAppearance.App.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">14dp</item>
    </style>

    <style name="ShapeAppearance.App.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ShapeAppearance.App.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">32dp</item>
    </style>

    <style name="GlassCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/space_glass</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.MediumComponent</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/glass_stroke</item>
    </style>

    <style name="NeonButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>
</resources>
